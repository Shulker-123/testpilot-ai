{
  "name": "testpilot-ai",
  "displayName": "TestPilot AI",
  "version": "1.0.0",
  "publisher": "Shulker-123",
  "description": "Automated unit test generation and coverage analysis engine for JavaScript/TypeScript powered by AST static analysis and LLMs.",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shulker-123/testpilot-ai"
  },
  "main": "src/extension.js",
  "bin": {
    "testpilot": "src/bin/run.js"
  },
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=18.x"
  },
  "categories": [
    "Testing",
    "Programming Languages",
    "Machine Learning"
  ],
  "activationEvents": [
    "onCommand:testpilot.generateTests",
    "onCommand:testpilot.expandTests",
    "onCommand:testpilot.runTests",
    "onLanguage:javascript",
    "onLanguage:typescript"
  ],
  "contributes": {
    "commands": [
      {
        "command": "testpilot.generateTests",
        "title": "TestPilot: Generate Unit Tests",
        "category": "TestPilot"
      },
      {
        "command": "testpilot.expandTests",
        "title": "TestPilot: Expand Tests for Higher Coverage",
        "category": "TestPilot"
      },
      {
        "command": "testpilot.runTests",
        "title": "TestPilot: Run Tests & Measure Coverage",
        "category": "TestPilot"
      },
      {
        "command": "testpilot.showPreview",
        "title": "TestPilot: Preview Generated Tests",
        "category": "TestPilot"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "testpilot.generateTests",
          "group": "testing",
          "when": "editorLangId == javascript || editorLangId == typescript"
        },
        {
          "command": "testpilot.expandTests",
          "group": "testing",
          "when": "resourceExtname == .test.js || resourceExtname == .spec.js"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "testpilot-sidebar",
          "title": "TestPilot",
          "icon": "system_architecture.png"
        }
      ]
    },
    "views": {
      "testpilot-sidebar": [
        {
          "type": "webview",
          "id": "testpilot.resultsView",
          "name": "Execution Results & Diagnostics"
        }
      ]
    },
    "configuration": {
      "title": "TestPilot Configuration",
      "properties": {
        "testpilot.model": {
          "type": "string",
          "default": "gemini-2.5-flash",
          "description": "Target LLM model for unit test synthesis"
        },
        "testpilot.backendUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "TestPilot backend REST server endpoint"
        }
      }
    }
  },
  "scripts": {
    "start:server": "node src/server.js",
    "test": "npx jest ./pythagora_tests/benchmark/ --coverage",
    "test:benchmark": "npx jest ./pythagora_tests/benchmark/",
    "generate-unit-tests": "node src/scripts/unit.js --path ./src"
  },
  "dependencies": {
    "@mswjs/interceptors": "^0.19.2",
    "@pythagora.io/js-code-processing": "^0.0.4",
    "axios": "^1.2.2",
    "blessed": "^0.1.81",
    "body-parser": "^1.20.1",
    "handlebars": "^4.7.7",
    "jest": "^29.5.0",
    "lodash": "^4.17.21",
    "nyc": "^15.1.0",
    "tryrequire": "^3.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "mongodb": "^5.6.0"
  },
  "keywords": [
    "test",
    "testing",
    "automation",
    "unit",
    "jest",
    "ai",
    "gemini",
    "ast",
    "vscode-extension"
  ]
}